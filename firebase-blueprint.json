{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "bio": { "type": "string" },
        "dailyGoalMinutes": { "type": "number" },
        "photoUrl": { "type": "string" },
        "avatarColor": { "type": "string" },
        "vestibulares": { "type": "array", "items": { "type": "string" } },
        "focusAreas": { "type": "array", "items": { "type": "string" } },
        "notifications": {
          "type": "object",
          "properties": {
            "lembretes": { "type": "boolean" },
            "novosGabaritos": { "type": "boolean" },
            "resumoSemanal": { "type": "boolean" }
          }
        },
        "frame": { "type": "string" },
        "badge": { "type": "string" },
        "themeColor": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "activePlanId": { "type": "string" },
        "planUpdatedAt": { "type": "string", "format": "date-time" },
        "paymentStatus": { "type": "string" },
        "paymentProvider": { "type": "string" },
        "paymentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Information about a specific vestibular exam",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "enum": ["ENEM", "Fuvest", "Unicamp", "Unesp", "UERJ", "ITA"] },
        "year": { "type": "integer" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "year"]
    },
    "Question": {
      "title": "Question",
      "description": "A single question from an exam or generated",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "text": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correctOption": { "type": "integer" },
        "explanation": { "type": "string" },
        "isOriginal": { "type": "boolean" }
      },
      "required": ["id", "text", "options", "correctOption"]
    },
    "EssayTheme": {
      "title": "EssayTheme",
      "description": "A theme for the essay part of the exam",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "year": { "type": "integer" },
        "theme": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "theme"]
    },
    "SubjectPerformance": {
      "title": "SubjectPerformance",
      "description": "User performance in a specific subject",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "totalQuestions": { "type": "number" },
        "correctQuestions": { "type": "number" },
        "percentage": { "type": "number" }
      },
      "required": ["userId", "subject", "totalQuestions", "correctQuestions", "percentage"]
    },
    "Progress": {
      "title": "Progress",
      "description": "User progress in a specific exam or subject",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "examId": { "type": "string" },
        "score": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "examId", "score"]
    },
    "QuizResult": {
      "title": "QuizResult",
      "description": "Result of a quiz attempt",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "questions": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "questionId": { "type": "string" },
              "selectedAnswer": { "type": "number" },
              "isCorrect": { "type": "boolean" }
            }
          }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "score", "totalQuestions", "percentage", "questions", "timestamp"]
    },
    "Essay": {
      "title": "Essay",
      "description": "User essay submissions and corrections",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "theme": { "type": "string" },
        "essayText": { "type": "string" },
        "generalCorrection": { "type": "string" },
        "competencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "score": { "type": "number" },
              "feedback": { "type": "string" },
              "improvementExample": { "type": "string" }
            }
          }
        },
        "grade": { "type": "number" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "theme", "essayText", "status", "timestamp"]
    },
    "Goal": {
      "title": "Goal",
      "description": "User study goals for a subject",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "targetAccuracy": { "type": "number" },
        "targetHours": { "type": "number" }
      },
      "required": ["userId", "subject", "targetAccuracy", "targetHours"]
    },
    "CardInteraction": {
      "title": "CardInteraction",
      "description": "User interaction with a single flashcard",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "cardId": { "type": "string" },
        "trailId": { "type": "string" },
        "status": { "type": "string", "enum": ["seen", "review"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "cardId", "trailId", "status", "updatedAt"]
    },
    "Questionnaire": {
      "title": "Questionnaire",
      "description": "User onboarding questionnaire data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "vestibulares": { "type": "array", "items": { "type": "string" } },
        "previousExams": { 
          "type": "array", 
          "items": { 
            "type": "object", 
            "properties": {
              "exam": { "type": "string" },
              "grade": { "type": "number" }
            }
          }
        },
        "studyMethod": { "type": "string" },
        "dailyHours": { "type": "number" },
        "easySubjects": { "type": "array", "items": { "type": "string" } },
        "hardSubjects": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" }
      },
      "required": ["userId", "vestibulares", "studyMethod", "dailyHours", "source"]
    },
    "CustomTrail": {
      "title": "CustomTrail",
      "description": "User-created custom flashcard trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 64 },
        "color_theme": { "type": "string", "maxLength": 32 },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "front_content": { "type": "string" },
              "back_content": { "type": "string" },
              "topic": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "category", "color_theme", "cards", "createdAt"]
    },
    "TreinoQuestao": {
      "title": "TreinoQuestao",
      "description": "Objective question stored in bank (admin writable)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "banca": { "type": "string" },
        "ano": { "type": "integer" },
        "materia": { "type": "string" },
        "topico": { "type": "string" },
        "dificuldade": { "type": "string", "enum": ["facil", "media", "dificil"] },
        "correta": { "type": "string" }
      },
      "required": ["id", "banca", "ano", "materia", "correta"]
    },
    "TreinoTentativa": {
      "title": "TreinoTentativa",
      "description": "User attempt in Treino Rápido",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "questaoId": { "type": "string", "maxLength": 128 },
        "alternativaEscolhida": { "type": "string" },
        "acertou": { "type": "boolean" },
        "tempoSeg": { "type": "number" },
        "xpGanho": { "type": "number" },
        "respondidaEm": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "questaoId", "alternativaEscolhida", "acertou"]
    },
    "TreinoRevisao": {
      "title": "TreinoRevisao",
      "description": "Spaced repetition state for a question",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "questaoId": { "type": "string", "maxLength": 128 },
        "passo": { "type": "integer" },
        "intervaloDias": { "type": "integer" },
        "proximaRevisaoEm": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "questaoId", "passo", "intervaloDias", "proximaRevisaoEm"]
    },
    "ReporteQuestao": {
      "title": "ReporteQuestao",
      "description": "User-submitted issue report for a question",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "questaoId": { "type": "string", "maxLength": 128 },
        "motivo": { "type": "string" },
        "detalhe": { "type": "string" }
      },
      "required": ["id", "userId", "questaoId", "motivo"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "Exams list"
    },
    "/exams/{examId}/questions/{questionId}": {
      "schema": "Question",
      "description": "Questions for an exam"
    },
    "/essayThemes/{themeId}": {
      "schema": "EssayTheme",
      "description": "Essay themes"
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": "Progress",
      "description": "User progress records"
    },
    "/quiz_results/{resultId}": {
      "schema": "QuizResult",
      "description": "Quiz results"
    },
    "/users/{userId}/subject_performance/{subject}": {
      "schema": "SubjectPerformance",
      "description": "User performance by subject"
    },
    "/essays/{essayId}": {
      "schema": "Essay",
      "description": "User essay submissions"
    },
    "/users/{userId}/goals/{subject}": {
      "schema": "Goal",
      "description": "User goals per subject"
    },
    "/users/{userId}/card_interactions/{cardId}": {
      "schema": "CardInteraction",
      "description": "User card interactions tracking seen/unseen cards"
    },
    "/users/{userId}/questionnaire": {
      "schema": "Questionnaire",
      "description": "User onboarding questionnaire data"
    },
    "/users/{userId}/custom_trails/{trailId}": {
      "schema": "CustomTrail",
      "description": "User-created custom flashcard trails"
    },
    "/users/{userId}/sisu_notas/{edicao}": {
      "schema": "SisuNotas",
      "description": "User Enem scores per valid edition"
    },
    "/users/{userId}/sisu_perfil/{docId}": {
      "schema": "SisuPerfil",
      "description": "User Sisu quota profile and selected options"
    },
    "/users/{userId}/sisu_simulacoes/{simulacaoId}": {
      "schema": "SisuSimulacao",
      "description": "Saved Sisu simulations history"
    },
    "/users/{userId}/sisu_favoritos/{cursoId}": {
      "schema": "SisuFavorito",
      "description": "User favorite Sisu courses"
    },
    "/sisu_cursos/{cursoId}": {
      "schema": "CursoSisu",
      "description": "Sisu courses catalog (admin writable)"
    },
    "/questoes/{questaoId}": {
      "schema": "TreinoQuestao",
      "description": "Treino Rápido question bank"
    },
    "/reportes_questoes/{reporteId}": {
      "schema": "ReporteQuestao",
      "description": "Reported errors on Treino Rápido questions"
    },
    "/users/{userId}/tentativas/{tentativaId}": {
      "schema": "TreinoTentativa",
      "description": "User Treino Rápido attempts"
    },
    "/users/{userId}/revisao/{questaoId}": {
      "schema": "TreinoRevisao",
      "description": "User spaced repetition schedule per question"
    },
    "/users/{userId}/treino_sessoes/{sessaoId}": {
      "schema": "TreinoTentativa",
      "description": "In-progress and finished Treino Rápido sessions"
    }
  }
}
